<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_jar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_jar_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🍫"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/widget_jar_big_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0/0"
        android:textColor="#5B3F82"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_jar_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_jar_label"
        android:textColor="#8A7867"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
