<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#DAD9F5" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:id="@android:id/background"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#F1E6D8" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item
        android:id="@android:id/progress"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#A88FBC" />
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
